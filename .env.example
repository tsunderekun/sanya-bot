# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Адрес локального LLM-сервера (Ollama):
OPENAI_BASE_URL=http://localhost:11434
OPENAI_API_KEY=ollama

# Имя модели (например, sanya)
MODEL_NAME=sanya

# Длина сохраняемой истории сообщений на чат и лимиты памяти
MAX_HISTORY_LENGTH=30
MAX_CONTEXT_CHARS=16000
MAX_QUEUE_SIZE=20
USER_COOLDOWN_SECONDS=5.0
MAX_PROACTIVE_PER_HOUR=3

# SOCKS5 или HTTP прокси для Telegram API и DuckDuckGo
TELEGRAM_PROXY=socks5://admin:Gazprom*123@192.168.1.253:1080
SEARCH_PROXY=socks5://admin:Gazprom*123@192.168.1.253:1080

# Включить поиск в интернете
ENABLE_WEB_SEARCH=true

# Поисковый движок: 'searxng' или 'duckduckgo'
SEARCH_ENGINE=searxng

# URL инстанса SearXNG (если используется SEARCH_ENGINE=searxng)
SEARXNG_URL=http://localhost:8080
